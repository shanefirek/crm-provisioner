  "description": "Natural language → typed ProvisionSpec (template + delta) → deterministic driver → CRM adapter (Salesforce, Zoho). MCP server interface — Claude is the UI.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "tsx watch src/host/server.ts",
    "smoke": "bash scripts/smoke-p0.sh",
    "start": "node --experimental-strip-types src/host/server.ts",
    "migrate": "bash scripts/migrate.sh",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  },
